  "info": {
    "_postman_id": "77136903-0ed3-4e1c-93a6-88b7d5599ff2",
    "name": "ODFL Bill of Lading Pickup API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Old Dominion Freight Line Bill of Lading API submits electronic bills of lading to the ODFL billing system. The service generates shipping labels and BOL documents that can be printed and applied to freight, enabling shippers to programmatically create freight documentation as part of their shipping workflow.\n\nContact Support:\n Name: ODFL API Support\n Email: api@odfl.com",
      "type": "text/plain"
    }
  }
