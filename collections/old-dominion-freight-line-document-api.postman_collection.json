                  "disabled": false,
                  "key": "documentType",
                  "value": "<string>",
                  "description": "Optional filter to retrieve a specific document type."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "proNumber",
                  "description": "(Required) ODFL PRO number identifying the shipment."
                }
