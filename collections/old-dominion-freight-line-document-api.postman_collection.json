            "description": {
              "content": "Returns the available PDF documents (bill of lading, delivery receipt) associated with the supplied ODFL PRO number.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "documents",
                ":proNumber"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
